# https://github.com/community-valheim-tools/valheim-server-docker/tree/main#environment-variables
SERVER_NAME="Midgaard"
SERVER_PORT=2456
WORLD_NAME="Midgaard"
SERVER_PASS="op://Dev/Valheim Server/Midgaard/password"
SERVER_PUBLIC=false
ADMINLIST_IDS="op://Dev/Valheim Server/ADMINLIST_IDS"
CROSSPLAY=true
TZ="America/Detroit"

BACKUPS=true
BACKUPS_IF_IDLE=true

VALHEIM_PLUS=false
BEPINEX=false

SUPERVISOR_HTTP=true
SUPERVISOR_HTTP_PORT=9001
SUPERVISOR_HTTP_USER="op://Dev/Valheim Server/SUPERVISOR_HTTP_USER"
SUPERVISOR_HTTP_PASS="op://Dev/Valheim Server/SUPERVISOR_HTTP_PASS"